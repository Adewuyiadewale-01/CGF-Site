    <span class="drop__caret" aria-hidden="true"></span>
    <div class="drop__stage">
      <div class="drop__menu" id="menu-security" data-menu="security">
        <div class="drop__body">
          <ul class="drop__grid">
            <li><a href="/security/cctv/"><span class="tile"><svg class="ic"><use href="#i-cctv"/></svg></span><span><b>CCTV &amp; cameras</b><small>AI cameras with live view on your phone</small></span></a></li>
            <li><a href="/security/alarm-system/"><span class="tile"><svg class="ic"><use href="#i-bell"/></svg></span><span><b>Alarm systems</b><small>Installs, upgrades and monitoring</small></span></a></li>
            <li><a href="/security/intercom/"><span class="tile"><svg class="ic"><use href="#i-door"/></svg></span><span><b>Intercom &amp; access</b><small>Video intercoms, fobs and keyless entry</small></span></a></li>
            <li><a href="/security/smoke-detectors/"><span class="tile"><svg class="ic"><use href="#i-flame"/></svg></span><span><b>Smoke alarms</b><small>Interconnected and tested to code</small></span></a></li>
            <li><a href="/security/site-security/"><span class="tile"><svg class="ic"><use href="#i-hardhat"/></svg></span><span><b>Site security</b><small>Temporary cameras and alarms for builds</small></span></a></li>
            <li><a href="/security/outdoor-security-lighting-installation/"><span class="tile"><svg class="ic"><use href="#i-bulb"/></svg></span><span><b>Security lighting</b><small>Sensor and flood lighting outdoors</small></span></a></li>
          </ul>
