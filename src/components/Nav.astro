<header class="nav" id="nav" data-state="top">
  <div class="nav__in">
    <a class="wm" href="/" aria-label="CGF Security and Electrical, home"><img class="wm__lockup" src="/assets/brand/site-lockup.svg" alt="" width="150" height="43"></a>
    <nav class="links" aria-label="Main">
      <ul>
        <li><button class="links__btn" type="button" aria-expanded="false" aria-controls="menu-security" data-menu="security">Security <svg class="ic ic--chev"><use href="#i-chev"/></svg></button></li>
        <li><button class="links__btn" type="button" aria-expanded="false" aria-controls="menu-electrical" data-menu="electrical">Electrical <svg class="ic ic--chev"><use href="#i-chev"/></svg></button></li>
        <li><a class="links__btn" href="/location/">Service areas</a></li>
        <li><button class="links__btn" type="button" aria-expanded="false" aria-controls="menu-company" data-menu="company">Company <svg class="ic ic--chev"><use href="#i-chev"/></svg></button></li>
      </ul>
