---
import Base from '../layouts/Base.astro';
const faq = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{"@type":"Question","name":"Do I need a licensed installer for CCTV and alarms in NSW?","acceptedAnswer":{"@type":"Answer","text":"Yes. In NSW, installing, maintaining or advising on security equipment requires a licence under the Security Industry Act 1997. CGF holds Master Licence 000104676, and every electrical connection is covered by Contractor Licence 487799C."}},
{"@type":"Question","name":"Can you work with my existing cameras or alarm?","acceptedAnswer":{"@type":"Answer","text":"Often, yes. We service and upgrade most major brands, including Dahua, Bosch, AJAX and Inception."}},
{"@type":"Question","name":"How much does CCTV installation cost in Sydney?","acceptedAnswer":{"@type":"Answer","text":"It depends on how many cameras you need, the cabling runs and how footage is recorded. We quote in writing after a site visit."}},
{"@type":"Question","name":"Can I view my cameras on my phone?","acceptedAnswer":{"@type":"Answer","text":"Yes. We set up the app at handover and show you live view, playback and alerts before we leave."}},
{"@type":"Question","name":"Do you install EV chargers and home batteries?","acceptedAnswer":{"@type":"Answer","text":"Yes. We check your switchboard first, then size the charger or battery to how you generate and use power."}},
{"@type":"Question","name":"Do you look after strata buildings?","acceptedAnswer":{"@type":"Answer","text":"Yes. We install and maintain lobby intercoms, fob access and common-area CCTV for strata committees and building managers."}}]};
---
<Base title={'Security & Electrical Sydney | CCTV, Alarms, Intercoms | CGF'} description={'CCTV, alarms, intercoms, access control and electrical work for Sydney homes, strata and businesses. One licensed team from Caringbah. Free quotes, call 1300 243 732.'} ogTitle={'CGF Security & Electrical — Sydney’s trusted security & electrical specialists'} path="/">
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/3d/hero-1440.webp" imagesrcset="/assets/3d/hero-640.webp 640w, /assets/3d/hero-960.webp 960w, /assets/3d/hero-1440.webp 1440w, /assets/3d/hero-2160.webp 2160w" imagesizes="100vw" fetchpriority="high">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faq)} />
  </Fragment>
<!-- ================= HERO ================= -->
<section class="hero" aria-labelledby="hero-h">
  <div class="hero__stage" id="hero-stage" aria-hidden="true"><img class="hero__poster" src="/assets/3d/hero-1440.webp" srcset="/assets/3d/hero-640.webp 640w, /assets/3d/hero-960.webp 960w, /assets/3d/hero-1440.webp 1440w, /assets/3d/hero-2160.webp 2160w" sizes="100vw" alt="" width="2880" height="1800" fetchpriority="high" decoding="async"></div>
  <div class="hero__callouts" aria-hidden="true">
    <span class="callout" data-anchor="solar"><i></i><em>Solar → board</em></span>
    <span class="callout" data-anchor="cam"><i></i><em>Cam 02 · tracking</em></span>
    <span class="callout" data-anchor="gate"><i></i><em>Gate · intercom live</em></span>
  </div>
  <div class="wrap hero__wrap">
    <p class="hero__coords mono">34.0446° S · 151.1172° E<br>CGF HQ — Caringbah, NSW</p>
    <div class="hero__copy">
      <h1 id="hero-h">Sydney’s trusted security &amp; electrical specialists.</h1>
      <p class="lede">We install CCTV, alarms and intercoms, and do the electrical work behind them ourselves. One licensed local team, from the first call to the handover.</p>
      <div class="ctas">
        <a class="btn btn--primary" href="#quote">Get a free quote <span class="btn__ar"><svg class="ic"><use href="#i-arrow"/></svg></span></a>
        <a class="btn btn--ghost" href="tel:1300243732" aria-label="Call 1300 243 732"><svg class="ic" aria-hidden="true"><use href="#i-phone"/></svg><span>Call <span class="cta-num">1300 243 732</span><span class="cta-us">us</span></span></a>
      </div>
    </div>
    <ul class="hero__trust mono">
      <li><span class="stars" aria-label="5 stars">★★★★★</span> Excellent · 170 Google reviews</li>
      <li>Security Master Lic. 000104676</li>
      <li>Electrical Contractor Lic. 487799C</li>
    </ul>
  </div>
  <aside class="sim" aria-label="Try it: arm a home">
    <header><span class="mono"><span class="dot"></span>Try it: arm a home</span><span class="sim__state mono" id="sim-state">Idle</span></header>
    <dl class="sim__stats">
      <div><dt class="mono">Cameras</dt><dd><strong id="sim-cams">0</strong><small>/3</small></dd></div>
      <div><dt class="mono">Zones armed</dt><dd><strong id="sim-zones">0</strong><small>/4</small></dd></div>
      <div><dt class="mono">Circuits</dt><dd><strong>6</strong></dd></div>
    </dl>
    <button class="hold" id="hold" type="button">
      <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="15" class="hold__track"/><circle id="hold-ring" cx="18" cy="18" r="15" class="hold__ring" transform="rotate(-90 18 18)"/></svg>
      <span><b id="hold-label">Hold to arm the property</b><span class="mono">Release to disarm</span></span>
    </button>
  </aside>
</section>

<!-- ================= MARQUEE ================= -->
<section class="marquee" aria-label="Systems we install and support">
  <div class="wrap marquee__in">
    <span class="mono">Installed + supported</span>
    <div class="marquee__track"><ul class="marquee__row">
      <li><img src="/assets/logos/dahua.svg" alt="Dahua" height="26" style="--h:26px" decoding="async"></li><li><img src="/assets/logos/ajax.svg" alt="Ajax Systems" height="19" style="--h:19px" decoding="async"></li><li><img src="/assets/logos/bosch.svg" alt="Bosch" height="27" style="--h:27px" decoding="async"></li><li><img src="/assets/logos/vimar.svg" alt="Vimar" height="22" style="--h:22px" decoding="async"></li><li><img src="/assets/logos/akuvox.png" alt="Akuvox" height="22" style="--h:22px" decoding="async"></li><li><img src="/assets/logos/inner-range.png" alt="Inner Range, maker of Inception and Integriti" height="24" style="--h:24px" decoding="async"></li>
      <li aria-hidden="true"><img src="/assets/logos/dahua.svg" alt="" height="26" style="--h:26px" decoding="async"></li><li aria-hidden="true"><img src="/assets/logos/ajax.svg" alt="" height="19" style="--h:19px" decoding="async"></li><li aria-hidden="true"><img src="/assets/logos/bosch.svg" alt="" height="27" style="--h:27px" decoding="async"></li><li aria-hidden="true"><img src="/assets/logos/vimar.svg" alt="" height="22" style="--h:22px" decoding="async"></li><li aria-hidden="true"><img src="/assets/logos/akuvox.png" alt="" height="22" style="--h:22px" decoding="async"></li><li aria-hidden="true"><img src="/assets/logos/inner-range.png" alt="" height="24" style="--h:24px" decoding="async"></li>
    </ul></div>
  </div>
</section>

<!-- ================= HOW IT'S WIRED ================= -->
<section class="wired" id="wired" aria-labelledby="wired-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="eyebrow">Why one team</p><h2 id="wired-h">Most security jobs need an electrician. We hold both licences.</h2></div>
      <p>A camera needs a circuit. A gate intercom needs power at the pillar. With two trades, that’s two visits, two invoices and no one owning the result. CGF holds a Security Master Licence and an Electrical Contractor Licence, so one team does all of it.</p>
    </header>
  </div>
  <div class="wired__pin" id="wired-pin">
    <div class="wrap wired__grid">
      <ol class="wired__rail" aria-hidden="true"><li class="is-on">01</li><li>02</li><li>03</li><li>04</li><li>05</li><li>∞</li></ol>
      <div class="wired__steps">
        <article class="step is-on" data-step="0" data-img="/assets/3d/power.jpg" data-tag="Board · 6 circuits live · 41% load">
          <p class="mono mono--sg">01 — The switchboard</p><h3>Every system starts at the board.</h3>
          <p>Before a single camera goes up, we check capacity, label the circuits and make room for what’s next: chargers, batteries, more cameras. Nothing trips later.</p>
          <dl class="specs"><div><dt>Load</dt><dd>Checked first</dd></div><div><dt>Circuits</dt><dd>Labelled + tested</dd></div><div><dt>Standard</dt><dd>AS/NZS 3000</dd></div></dl>
        </article>
        <article class="step" data-step="1" data-img="/assets/3d/hero-a0.5.jpg" data-tag="Power + lighting · runs energised">
          <p class="mono mono--sg">02 — Power &amp; lighting</p><h3>Power goes where the devices will be.</h3>
          <p>Circuits for cameras, the gate and the EV charger are run at the same time as lighting and power points, so walls get opened once.</p>
          <dl class="specs"><div><dt>Runs</dt><dd>Planned on site</dd></div><div><dt>Lighting</dt><dd>Sensor + flood</dd></div><div><dt>Visits</dt><dd>One</dd></div></dl>
        </article>
        <article class="step" data-step="2" data-img="/assets/3d/cctv.jpg" data-tag="Cam 02 · person detected · 14:02">
          <p class="mono mono--sg">03 — Cameras</p><h3>Cameras that tell a person from a possum.</h3>
          <p>AI-enabled CCTV, placed for the angles that matter: driveways, entries, side paths. Live view and playback on your phone, with footage you can actually find.</p>
          <dl class="specs"><div><dt>Detection</dt><dd>Person + vehicle</dd></div><div><dt>Viewing</dt><dd>Phone app</dd></div><div><dt>Brands</dt><dd>Dahua and more</dd></div></dl>
        </article>
        <article class="step" data-step="3" data-img="/assets/3d/alarm.jpg" data-tag="Zone 3 · rear living · armed">
          <p class="mono mono--sg">04 — Alarm &amp; sensors</p><h3>Alarms that say which door, not just “alarm”.</h3>
          <p>Zoned sensors, keypads and back-to-base monitoring on AJAX, Bosch and Inception systems, with interconnected smoke alarms tested to code.</p>
          <dl class="specs"><div><dt>Zones</dt><dd>Mapped per room</dd></div><div><dt>Monitoring</dt><dd>Back-to-base</dd></div><div><dt>Smoke</dt><dd>Interconnected</dd></div></dl>
        </article>
        <article class="step" data-step="4" data-img="/assets/3d/access.jpg" data-tag="Gate · fob 14 accepted">
          <p class="mono mono--sg">05 — Intercom &amp; access</p><h3>See who’s at the gate. Let them in from anywhere.</h3>
          <p>Video intercoms and fob access for houses, unit blocks and strata lobbies. Add or cancel a fob without re-keying a single lock.</p>
          <dl class="specs"><div><dt>Intercoms</dt><dd>Akuvox, Vimar</dd></div><div><dt>Access</dt><dd>Integriti, Inception</dd></div><div><dt>Unlock</dt><dd>From your phone</dd></div></dl>
        </article>
        <article class="step" data-step="5" data-img="/assets/3d/hero.jpg" data-tag="All systems · one number">
          <p class="mono mono--sg">∞ — Support</p><h3>One number for all of it, after handover.</h3>
          <p>The people who installed it are the people who answer. Remote troubleshooting, servicing and upgrades, without working out which trade to call.</p>
          <dl class="specs"><div><dt>Call</dt><dd>1300 243 732</dd></div><div><dt>Remote</dt><dd>Troubleshooting</dd></div><div><dt>Service</dt><dd>Same team</dd></div></dl>
        </article>
      <div class="wired__next" aria-hidden="true">
        <p class="mono">Next</p>
        <ol id="wired-next"><li>02 — Power &amp; lighting</li><li>03 — Cameras</li><li>04 — Alarm &amp; sensors</li><li>05 — Intercom &amp; access</li><li>∞ — One number for support</li></ol>
      </div>
      </div>
      <div class="wired__sticky">
      <figure class="wired__stage" id="wired-stage">
        <img id="wired-img" src="/assets/3d/power-1440.webp" srcset="/assets/3d/power-640.webp 640w, /assets/3d/power-960.webp 960w, /assets/3d/power-1440.webp 1440w, /assets/3d/power-2160.webp 2160w" sizes="(min-width: 861px) 50vw, 100vw" loading="lazy" decoding="async" alt="3D render of an open switchboard with live circuits leaving the top" width="1200" height="900">
        <figcaption class="tag mono"><span class="dot"></span><span id="wired-tag">Board · 6 circuits live · 41% load</span></figcaption>
        <div class="wired__count" aria-hidden="true"><b id="wired-num">01</b><small>/ 06</small><span class="mono" id="wired-name">The switchboard</span></div>
        <div class="wired__bar" aria-hidden="true"><i id="wired-bar"></i></div>
      </figure>
      </div>
    </div>
  </div>
</section>

<!-- ================= SERVICES ================= -->
<section class="services band" id="services" aria-labelledby="svc-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="eyebrow">Services</p><h2 id="svc-h">Four disciplines.<br>One licensed team.</h2></div>
      <p>Specified for the property, not pulled from a catalogue. Every install is tested, handed over in person and supported by the people who did the work.</p>
    </header>
    <div class="cards">
      <article class="card">
        <div class="card__vis" data-scene="cctv"><img src="/assets/3d/cctv-960.webp" srcset="/assets/3d/cctv-640.webp 640w, /assets/3d/cctv-960.webp 960w, /assets/3d/cctv-1440.webp 1440w, /assets/3d/cctv-2160.webp 2160w" sizes="(min-width: 1181px) 25vw, (min-width: 861px) 50vw, 100vw" decoding="async" alt="3D render of a turret security camera scanning a driveway" width="1200" height="900" loading="lazy"></div>
        <div class="card__b"><p class="card__top mono"><span class="mono--sg">Security · 01</span><span>Dahua</span></p>
          <h3>CCTV &amp; cameras</h3><p>AI-enabled cameras for homes, strata, retail and warehouses, with live view and playback on your phone.</p>
          <ul class="chips"><li><a href="/security/cctv/">Home CCTV <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/cctv/">Strata CCTV <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/cctv/">Business CCTV <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li></ul></div>
      </article>
      <article class="card">
        <div class="card__vis" data-scene="alarm"><img src="/assets/3d/alarm-960.webp" srcset="/assets/3d/alarm-640.webp 640w, /assets/3d/alarm-960.webp 960w, /assets/3d/alarm-1440.webp 1440w, /assets/3d/alarm-2160.webp 2160w" sizes="(min-width: 1181px) 25vw, (min-width: 861px) 50vw, 100vw" decoding="async" alt="3D render of an alarm keypad and motion sensor with its detection curtain" width="1200" height="900" loading="lazy"></div>
        <div class="card__b"><p class="card__top mono"><span class="mono--sg">Security · 02</span><span>AJAX · Bosch · Inception</span></p>
          <h3>Alarms &amp; sensors</h3><p>New installs, upgrades and back-to-base monitoring, plus interconnected smoke alarms tested to code.</p>
          <ul class="chips"><li><a href="/security/alarm-system/">Alarm installation <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/alarm-system/">Monitoring <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/smoke-detectors/">Smoke alarms <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li></ul></div>
      </article>
      <article class="card">
        <div class="card__vis" data-scene="access"><img src="/assets/3d/access-960.webp" srcset="/assets/3d/access-640.webp 640w, /assets/3d/access-960.webp 960w, /assets/3d/access-1440.webp 1440w, /assets/3d/access-2160.webp 2160w" sizes="(min-width: 1181px) 25vw, (min-width: 861px) 50vw, 100vw" decoding="async" alt="3D render of a video intercom and fob reader on a gate pillar" width="1200" height="900" loading="lazy"></div>
        <div class="card__b"><p class="card__top mono"><span class="mono--sg">Security · 03</span><span>Akuvox · Vimar · Integriti</span></p>
          <h3>Intercom &amp; access</h3><p>Video intercoms and keyless entry for houses, unit blocks and strata lobbies. Add or cancel a fob without re-keying.</p>
          <ul class="chips"><li><a href="/security/intercom/">Video intercoms <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/intercom/">Access control <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/security/intercom/">Strata entries <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li></ul></div>
      </article>
      <article class="card">
        <div class="card__vis" data-scene="power"><img src="/assets/3d/power-960.webp" srcset="/assets/3d/power-640.webp 640w, /assets/3d/power-960.webp 960w, /assets/3d/power-1440.webp 1440w, /assets/3d/power-2160.webp 2160w" sizes="(min-width: 1181px) 25vw, (min-width: 861px) 50vw, 100vw" decoding="async" alt="3D render of an open switchboard beside an EV charger" width="1200" height="900" loading="lazy"></div>
        <div class="card__b"><p class="card__top mono"><span class="mono--sg">Electrical · 04</span><span>Lic. 487799C</span></p>
          <h3>Electrical &amp; energy</h3><p>Switchboards, lighting, fault-finding, solar, home batteries and EV chargers, by the team that runs your security.</p>
          <ul class="chips"><li><a href="/electrical/residential-services/">Residential <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/electrical/commercial-services/">Commercial <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/electrical/renewables-energy/">Solar + batteries <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li><li><a href="/electrical/renewables-energy/">EV chargers <svg class="ic"><use href="#i-arrow-ur"/></svg></a></li></ul></div>
      </article>
    </div>
    <p class="also"><span class="mono mono--sg">Also</span><a href="/security/site-security/">Construction site security</a><a href="/security/outdoor-security-lighting-installation/">Outdoor security lighting</a><a href="/electrical/maintenance-repairs/">Maintenance &amp; repairs</a></p>
  </div>
</section>

<!-- ================= WHO WE WORK WITH ================= -->
<section class="who" aria-labelledby="who-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="eyebrow">Who we work with</p><h2 id="who-h">Built around the property.</h2></div></header>
    <div class="table" role="table" aria-label="Typical systems by property type">
      <div class="tr th" role="row"><span role="columnheader">Property</span><span role="columnheader">Typical system</span><span role="columnheader">What clients ask first</span></div>
      <a class="tr" role="row" href="/who-we-work-with/homes/" data-peek="0"><span role="cell" class="t-name"><span class="t-thumb"><img src="/assets/work/homes.jpg" alt="CGF technician fitting a video intercom to a home’s front gate" width="720" height="900" loading="lazy"></span>Homes</span><span role="cell">4–6 cameras, monitored alarm, video doorbell or gate intercom, EV-ready switchboard</span><span role="cell" class="t-q">“Can I see who’s at the gate from my phone?”</span><svg class="ic"><use href="#i-arrow-ur"/></svg></a>
      <a class="tr" role="row" href="/who-we-work-with/strata-apartments/" data-peek="1"><span role="cell" class="t-name"><span class="t-thumb"><img src="/assets/work/strata.jpg" alt="Apartment block entry gate with a video intercom and keypad" width="720" height="900" loading="lazy"></span>Strata &amp; apartments</span><span role="cell">Lobby video intercom, fob access, common-area and car-park CCTV, sensor lighting</span><span role="cell" class="t-q">“Can the committee pull footage without calling you?”</span><svg class="ic"><use href="#i-arrow-ur"/></svg></a>
      <a class="tr" role="row" href="/who-we-work-with/businesses/" data-peek="2"><span role="cell" class="t-name"><span class="t-thumb"><img src="/assets/work/business.jpg" alt="CGF technician walking a business owner through the CCTV recorder" width="720" height="900" loading="lazy"></span>Businesses &amp; retail</span><span role="cell">AI CCTV with remote viewing, monitored alarm, after-hours access, fit-out electrical</span><span role="cell" class="t-q">“Will it know the difference between a person and a cat?”</span><svg class="ic"><use href="#i-arrow-ur"/></svg></a>
      <a class="tr" role="row" href="/who-we-work-with/construction-sites/" data-peek="3"><span role="cell" class="t-name"><span class="t-thumb"><img src="/assets/work/construction.jpg" alt="CGF technician fitting a wireless alarm sensor to a construction site fence" width="720" height="900" loading="lazy"></span>Construction sites</span><span role="cell">Temporary cameras and alarms, site power, staged handover to the permanent system</span><span role="cell" class="t-q">“Can it move with the build?”</span><svg class="ic"><use href="#i-arrow-ur"/></svg></a>
    </div>
    <figure class="peek" aria-hidden="true"><div class="peek__frame"><img src="/assets/work/homes.jpg" alt="" width="720" height="900" loading="lazy"><img src="/assets/work/strata.jpg" alt="" width="720" height="900" loading="lazy"><img src="/assets/work/business.jpg" alt="" width="720" height="900" loading="lazy"><img src="/assets/work/construction.jpg" alt="" width="720" height="900" loading="lazy"></div><figcaption class="mono"><span>Gate intercom · home</span><span>Strata entry · intercom + keypad</span><span>Business · CCTV handover</span><span>Site fence · wireless alarm</span></figcaption></figure>
  </div>
</section>

<!-- ================= PROCESS ================= -->
<section class="process band" aria-labelledby="proc-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="eyebrow">How we work</p><h2 id="proc-h">A clear process, from the first call to the handover.</h2></div>
      <p>No surprises on the invoice and no hand-offs between trades. The same team quotes, installs and supports the job.</p>
    </header>
    <div class="rail" aria-hidden="true"></div>
    <ol class="steps5">
      <li><span class="tile"><svg class="ic"><use href="#i-msg"/></svg></span><span class="mono">01</span><h3>Free quote</h3><p>Tell us what you need. We call back within 24 hours with real questions, not a sales pitch.</p></li>
      <li><span class="tile"><svg class="ic"><use href="#i-ruler"/></svg></span><span class="mono">02</span><h3>Site visit &amp; design</h3><p>We check the property, switchboard and cable paths, then put the design and price in writing.</p></li>
      <li><span class="tile"><svg class="ic"><use href="#i-cable"/></svg></span><span class="mono">03</span><h3>Installation</h3><p>Licensed technicians install, test and tidy up. Power and security by one team, in one visit.</p></li>
      <li><span class="tile"><svg class="ic"><use href="#i-cap"/></svg></span><span class="mono">04</span><h3>Handover &amp; training</h3><p>We set up the app on your phone, walk you through the system and leave written instructions.</p></li>
      <li><span class="tile"><svg class="ic"><use href="#i-buoy"/></svg></span><span class="mono">05</span><h3>Ongoing support</h3><p>Remote fixes, servicing and upgrades from the same people who installed it, not a call centre.</p></li>
    </ol>
  </div>
</section>

<!-- ================= PEOPLE ================= -->
<section class="people" aria-labelledby="ppl-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="eyebrow">Our team</p><h2 id="ppl-h" class="h-xl">Guard. Govern. Protect.</h2><p class="mono mono--sg latin">Custodire · Gubernare · Firmare</p></div>
      <div class="ppl-copy"><p>The CGF name comes from founder Chad’s personal motto, the one he has tattooed on his arm.</p><p>He grew up in a rough part of England, around people who knew how to find a weakness. So before we recommend anything, we look at your property the way someone trying to get in would.</p></div>
    </header>
    <div class="photos">
      <figure class="ph ph--a reveal"><img src="/assets/team/DSC06427.jpg" alt="Two CGF technicians checking a new device before installing it" width="1400" height="788" loading="lazy"><figcaption class="mono">On site · checking kit before the install</figcaption></figure>
